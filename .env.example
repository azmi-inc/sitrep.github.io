# Bind locally by default. For a public host, explicitly set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8787

# Optional dedicated Supabase project configuration.
# Not currently connected or required to run the public read-only dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret; never expose this to browser code.
SUPABASE_SECRET_KEY=
